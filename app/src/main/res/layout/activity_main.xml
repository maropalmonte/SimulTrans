<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Fila de estado + indicador de "traduciendo..." -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="12dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:text="@string/status_loading" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPickModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:text="@string/btn_pick_model" />

    <!-- Selector de pestaña: Traductor / Asistente IA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:weightSum="2">

        <Button
            android:id="@+id/tabTranslator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="@color/text_primary"
            android:text="Traductor" />
        <Button
            android:id="@+id/tabAssistant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="@color/text_primary"
            android:text="Asistente IA" />
    </LinearLayout>

    <!-- ==================== PESTAÑA TRADUCTOR ==================== -->
    <LinearLayout
        android:id="@+id/translatorContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Selectores de los 2 idiomas de la conversación actual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:weightSum="2">

            <Spinner
                android:id="@+id/spinnerLangA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/spinner_background" />

            <Spinner
                android:id="@+id/spinnerLangB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/spinner_background" />
        </LinearLayout>

        <!-- Botón para borrar la conversación guardada -->
        <TextView
            android:id="@+id/btnClearHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:text="Borrar conversación"
            android:textColor="@color/spanish_color"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/transcriptContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:weightSum="2">
            <Button
                android:id="@+id/btnLangA"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textColor="#FFFFFF"
                android:enabled="false"
                android:text="" />

            <Button
                android:id="@+id/btnLangB"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="#FFFFFF"
                android:enabled="false"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== PESTAÑA ASISTENTE IA ==================== -->
    <LinearLayout
        android:id="@+id/assistantContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Idioma de voz para dictar la pregunta y leer la respuesta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idioma de voz:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spinnerAssistantLang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/spinner_background" />
        </LinearLayout>

        <!-- Botón para borrar la conversación guardada del Asistente -->
        <TextView
            android:id="@+id/btnClearAssistantHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:text="Borrar conversación"
            android:textColor="@color/spanish_color"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <ScrollView
            android:id="@+id/assistantScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/assistantTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

        <!-- Nombre del archivo adjunto pendiente de enviar (oculto si no hay ninguno) -->
        <TextView
            android:id="@+id/txtAttachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnAttach"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/text_primary"
                android:text="📎" />

            <Button
                android:id="@+id/btnMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/text_primary"
                android:text="🎤" />

            <EditText
                android:id="@+id/promptInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/spinner_background"
                android:hint="Escribe o dicta tu pregunta..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:padding="10dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/chkSpeakResponses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="4dp"
            android:text="🔊 Leer respuesta en voz alta"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSendPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/english_color"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:text="Enviar" />
    </LinearLayout>
</LinearLayout>
